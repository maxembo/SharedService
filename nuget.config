<?xml version="1.0" encoding="utf-8"?>

<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/maxembo/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_NUGET_USER%" />
      <add key="ClearTextPassword"
           value="%GITHUB_NUGET_TOKEN%" />
    </github>
  </packageSourceCredentials>
  
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    
    <packageSource key="github">
      <package pattern="SharedService.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>